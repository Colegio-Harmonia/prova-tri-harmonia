# Postgres (docker-compose)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://prova_tri:@localhost:5434/prova_tri

# Auth.js
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://192.168.1.218:3010

# Login Google OAuth institucional (colegioharmonia.com.br) — criar em
# console.cloud.google.com > APIs & Services > Credentials, tipo "OAuth
# client ID" / Web application. Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google (service account reused from harmohub)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/home/eduardo/harmohub/credentials/service-account.json
DRIVE_ROOT_FOLDER_ID=
# Pasta canônica `Imagens ENEM`; quando definida, os importadores gravam
# diretamente em <esta-pasta>/<ano>, sem criar outra pasta `Imagens ENEM`.
DRIVE_ENEM_IMAGES_FOLDER_ID=

# Google Chat — service account que pertence ao app Google Chat Prova-tri no
# projeto hubharmonia. Não use webhook de espaço coletivo.
GOOGLE_CHAT_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_CHAT_PUBLIC_BASE_URL=https://prova.colegioharmonia.com.br
GOOGLE_CHAT_ENDPOINT_AUDIENCE=https://prova.colegioharmonia.com.br/api/integrations/google-chat

# Google Docs templates (set after running `npm run seed-templates`)
TEMPLATE_PROVA_DOC_ID=
TEMPLATE_GABARITO_DOC_ID=
TEMPLATE_MAPA_DOC_ID=

# DeepSeek — geração de questões (trocado do Gemini em 14/07/2026, ver
# src/lib/gemini/llmClient.ts)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# OpenAI — habilite somente quando um perfil OpenAI estiver ativo no painel
# `/ia`. O mesmo segredo atende GPT para texto e DALL-E para imagem.
OPENAI_API_KEY=
# Anthropic Claude Vision para validar layout e legibilidade das imagens.
ANTHROPIC_API_KEY=
# Teto diário de chamadas ao provedor (sucessos, rejeições e falhas). Usa UTC;
# 0 desativa deliberadamente o limite. Ajuste antes de ativar IA em um novo ambiente.
AI_DAILY_OPERATION_BUDGET=50

# Gemini — só usado pra geração de imagem de apoio (fallback quando a busca
# no Wikimedia Commons não acha nada). DeepSeek não gera imagem.
GEMINI_API_KEY=
# Modelo exclusivo para transcrever respostas manuscritas. Não compartilhe
# `GEMINI_VISION_MODEL`: a troca de um não deve derrubar o outro.
GEMINI_SCAN_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
